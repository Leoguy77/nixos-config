#!/usr/bin/env bash
#
# Pre-commit hook to enforce signed commits
# Install: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}🔒 Enforce Signed Commits - Checking configuration...${NC}"
echo ""

ERRORS=0

# Check 1: Is commit signing enabled?
GPGSIGN=$(git config --get commit.gpgsign 2>/dev/null || echo "")
if [ "$GPGSIGN" != "true" ]; then
    echo -e "${RED}✗ Commit signing is NOT enabled${NC}"
    echo -e "  ${YELLOW}Fix:${NC} git config commit.gpgsign true"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}✓${NC} Commit signing is enabled"
fi

# Check 2: Is gpg.format set to ssh?
GPG_FORMAT=$(git config --get gpg.format 2>/dev/null || echo "")
if [ "$GPG_FORMAT" != "ssh" ]; then
    echo -e "${RED}✗ Git is not configured for SSH signing${NC}"
    echo -e "  ${YELLOW}Fix:${NC} git config gpg.format ssh"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}✓${NC} Using SSH for signing"
fi

# Check 3: Is SSH auth socket set?
if [ -z "$SSH_AUTH_SOCK" ]; then
    echo -e "${RED}✗ SSH_AUTH_SOCK is not set${NC}"
    echo -e "  ${YELLOW}Fix:${NC} eval \$(op ssh-agent --start)"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}✓${NC} SSH agent is configured (${SSH_AUTH_SOCK##*/})"
fi

# Check 4: Is allowedSignersFile configured and exists?
ALLOWED_SIGNERS=$(git config --get gpg.ssh.allowedSignersFile 2>/dev/null || echo "")
if [ -z "$ALLOWED_SIGNERS" ]; then
    echo -e "${RED}✗ gpg.ssh.allowedSignersFile is not configured${NC}"
    echo -e "  ${YELLOW}Fix:${NC} git config gpg.ssh.allowedSignersFile ~/.ssh/allowed_signers"
    ERRORS=$((ERRORS + 1))
elif [ ! -f "$ALLOWED_SIGNERS" ]; then
    echo -e "${RED}✗ Allowed signers file not found: $ALLOWED_SIGNERS${NC}"
    echo -e "  ${YELLOW}Fix:${NC} Create the file with your SSH public key"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}✓${NC} Allowed signers file exists"
fi

# Check 5: Is 1Password CLI available?
if ! command -v op &> /dev/null; then
    echo -e "${RED}✗ 1Password CLI (op) not found${NC}"
    echo -e "  ${YELLOW}Fix:${NC} Install 1Password CLI from https://1password.com/downloads/command-line/"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}✓${NC} 1Password CLI is installed"
fi

echo ""

# Final result
if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}╔════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║  COMMIT BLOCKED: $ERROR_ERRORS configuration issue(s) found           ║${NC}"
    echo -e "${RED}╚════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}Run the setup script to fix all issues:${NC}"
    echo "  ./pi-extensions/enforce-signed-commits/setup.sh"
    echo ""
    exit 1
fi

echo -e "${GREEN}╔════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║  All signing checks passed! ✓                         ║${NC}"
echo -e "${GREEN}╚════════════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${BLUE}Proceeding with signed commit...${NC}"
echo ""

# Success - allow commit to proceed
exit 0
