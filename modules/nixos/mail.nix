# Mail stack: nixos-mailserver (Postfix + Dovecot + rspamd + opendkim) plus
# Roundcube webmail.
#
# Everything is Nix-declared: accounts, aliases, quotas, DKIM keys, TLS. No
# setup wizard, no configuration that lives in a database Nix cannot read.
# That is the whole reason this module exists — the previous Stalwart setup
# kept its real configuration in RocksDB, writable only through a web UI on
# first boot, so the flake never described the running server.
#
# TLS layout (one public IPv4, two names):
#
#   webmail.<domain> ──> nginx :80 (ACME webroot) and :443 (Roundcube)
#   mail.<domain>    ──> Postfix :25/:465/:587, Dovecot :143/:993, Sieve :4190
#
# A single certificate is issued for mail.<domain> over HTTP-01 and shared:
# nginx serves the challenge on :80 for that name, Postfix and Dovecot read the
# same files from /var/lib/acme. No TLS passthrough and no ALPN: the NixOS ACME
# module cannot do standalone/ALPN at all (its only non-DNS modes are
# `webroot`, `listenHTTP` and `s3Bucket`), and it does not need to.
{
  config,
  pkgs,
  lib,
  ...
}:

let
  cfg = config.modules.mail;

  # DKIM keys are private key material, so they live outside the Nix store
  # (which is world-readable). rspamd reads them at runtime.
  dkimDir = "/var/lib/dkim";

  firstAccount = "${builtins.head (builtins.attrNames cfg.accounts)}@${cfg.domain}";

  # ── MTA-STS (RFC 8461) ────────────────────────────────────────────────
  # Senders fetch this over HTTPS only if the _mta-sts TXT record advertises it,
  # and they refuse to use a policy whose `id` no longer matches the TXT. That
  # coupling is the whole security property, so the id is DERIVED from the
  # policy text instead of being typed into dns.nix: editing the policy without
  # bumping the id would leave senders silently using the old rules.
  mtaStsPolicy = ''
    version: STSv1
    mode: enforce
    mx: ${cfg.hostname}
    max_age: 604800
  '';
  # Senders compare the id as an opaque token; any stable fingerprint works.
  # `builtins.hashString` keeps it dependency-free (no nixpkgs hash tool in the
  # build) and is deterministic, so the record generated by dns.nix and the file
  # served by nginx always agree however they are built.
  mtaStsId = builtins.substring 0 20 (builtins.hashString "sha256" mtaStsPolicy);

  # ── Client autoconfiguration ──────────────────────────────────────────
  # Thunderbird reads autoconfig.<domain>, Outlook reads autodiscover.<domain>,
  # and both were previously advertised by DNS while returning 404s under a
  # certificate that did not cover the names. Serving them here makes the
  # records true. Values mirror services.roundcube's extraConfig above, because
  # a client that autoconfigures must land on exactly what webmail uses.
  autoconfigXml = ''
    <?xml version="1.0" encoding="UTF-8"?>
    <clientConfig version="1.1">
      <emailProvider id="${cfg.domain}">
        <domain>${cfg.domain}</domain>
        <displayName>${cfg.domain} Mail</displayName>
        <displayShortName>${cfg.domain}</displayShortName>
        <incomingServer type="imap">
          <hostname>${cfg.hostname}</hostname>
          <port>993</port>
          <socketType>SSL</socketType>
          <authentication>password-cleartext</authentication>
          <username>%EMAILADDRESS%</username>
        </incomingServer>
        <outgoingServer type="smtp">
          <hostname>${cfg.hostname}</hostname>
          <port>465</port>
          <socketType>SSL</socketType>
          <authentication>password-cleartext</authentication>
          <username>%EMAILADDRESS%</username>
        </outgoingServer>
      </emailProvider>
    </clientConfig>
  '';

  # Outlook's autodiscover schema. Same endpoints as above, expressed as its
  # own dialect; clients that ignore it fall back to the SRV records.
  autodiscoverXml = ''
    <?xml version="1.0" encoding="UTF-8"?>
    <Autodiscover xmlns="http://schemas.microsoft.com/exchange/autodiscover/responseschema/2006">
      <Response>
        <Account>
          <AccountType>email</AccountType>
          <Action>settings</Action>
          <Protocol>
            <Type>IMAP</Type>
            <Server>${cfg.hostname}</Server>
            <Port>993</Port>
            <SSL>on</SSL>
            <SPA>off</SPA>
            <AuthRequired>on</AuthRequired>
          </Protocol>
          <Protocol>
            <Type>SMTP</Type>
            <Server>${cfg.hostname}</Server>
            <Port>465</Port>
            <SSL>on</SSL>
            <SPA>off</SPA>
            <AuthRequired>on</AuthRequired>
          </Protocol>
        </Account>
      </Response>
    </Autodiscover>
  '';

  autoconfigHosts = [
    "autoconfig.${cfg.domain}"
    "autodiscover.${cfg.domain}"
    "mta-sts.${cfg.domain}"
  ];

  # Response headers, repeated wherever nginx would otherwise drop them (see
  # commonHttpConfig below). Lives here so the roundcube vhost and the
  # autoconfig vhosts share one definition.
  #
  # No `includeSubDomains`: the zone has subdomains this host does not serve
  # (`wing` is CF_PROXY_OFF and speaks a non-HTTP protocol, and the rest live on
  # a box that is still Debian). HSTS would commit all of them to HTTPS from
  # every browser that ever saw this header, and it cannot be undone remotely.
  # Add it once every subdomain terminates TLS here.
  secHeaders = ''
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
  '';

  # Standard paths only — these are what clients actually request:
  #   Thunderbird  GET https://autoconfig.<domain>/mail/config-v1.1.xml
  autoconfigSite = pkgs.runCommand "mail-autoconfig" { } ''
    mkdir -p $out/mail $out/.well-known $out/autodiscover
    cp ${pkgs.writeText "config-v1.1.xml" autoconfigXml} $out/mail/config-v1.1.xml
    cp ${pkgs.writeText "autodiscover.xml" autodiscoverXml} $out/autodiscover/autodiscover.xml
    cp ${pkgs.writeText "mta-sts.txt" mtaStsPolicy} $out/.well-known/mta-sts.txt
  '';

  # One vhost per name above. All three serve the same directory, so this is one
  # definition repeated rather than three hand-written blocks that could drift.
  #
  # Served straight from the store: the policy and the XML are fixed at build
  # time, and mtaStsId is derived from mtaStsPolicy, so DNS and the served file
  # cannot disagree. No tmpfiles rule, no activation service, no /var copy.
  autoconfigVhosts = lib.genAttrs autoconfigHosts (_name: {
    enableACME = true;
    forceSSL = true;
    root = autoconfigSite;
    extraConfig = secHeaders;
  });
in

{
  options.modules.mail = {
    enable = lib.mkEnableOption "the mail server (Postfix, Dovecot, rspamd, Roundcube)";

    hostname = lib.mkOption {
      type = lib.types.str;
      description = "Mail hostname (MX, SMTP, IMAP, TLS certificate).";
      example = "mail.example.com";
    };

    webmailHostname = lib.mkOption {
      type = lib.types.str;
      description = ''
        Hostname for the Roundcube webmail UI. Must differ from {option}`hostname`
        so that only one nginx vhost owns port 443 for a given name.
      '';
      example = "webmail.example.com";
    };

    domain = lib.mkOption {
      type = lib.types.str;
      description = "The mail domain being served (the part after the @).";
      example = "example.com";
    };

    acmeEmail = lib.mkOption {
      type = lib.types.str;
      description = "Contact address for Let's Encrypt.";
    };

    dnssecValidation = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Make the local resolver validate DNSSEC and report validity to Postfix.

        Required for DANE (RFC 7672) to do anything. Postfix's
        `smtp_dns_support_level = dnssec` does not validate signatures itself;
        it asks the resolver and only uses the answer if the resolver says the
        data was validated (the AD bit). A resolver that does not validate
        never sets that bit, so Postfix silently falls back to opportunistic
        `tls=may` and a bogus TLSA record is ignored rather than enforced.

        Sets `DNS` to the local kresd recursor, with public resolvers only as
        `FallbackDNS`. `DNS` must be explicit: left unset, resolved uses the
        link-provided servers and fails every unsigned zone with
        "no-signature".
      '';
    };

    accounts = lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.submodule {
          options = {
            hashedPasswordFile = lib.mkOption {
              type = lib.types.nullOr lib.types.path;
              default = null;
              description = ''
                File containing the account's password hash, as produced by
                `mkpasswd -m sha-512`. Use a sops secret: a hash is still a
                credential, just not a plaintext one.
              '';
            };

            passwordFile = lib.mkOption {
              type = lib.types.nullOr lib.types.path;
              default = null;
              description = ''
                File containing the plaintext password. Prefer
                {option}`hashedPasswordFile`; this exists for secrets managers
                that hand out cleartext.
              '';
            };

            aliases = lib.mkOption {
              type = lib.types.listOf lib.types.str;
              default = [ ];
              description = "Extra addresses delivered to this account.";
            };

            sieveScript = lib.mkOption {
              type = lib.types.nullOr lib.types.lines;
              default = null;
              example = ''
                require ["fileinto"];

                if address :is ["to", "x-original-to"] "dmarc@example.com" {
                  fileinto "DMARC";
                  stop;
                }
              '';
              description = ''
                Per-account Sieve script, installed as the account's DEFAULT
                script. It occupies the `default` slot, so the webmail's
                ManageSieve pane cannot see or edit it: the Nix file is the
                source of truth and a UI edit would be silently replaced on the
                next rebuild.

                Two constraints worth knowing:

                - The spam filter runs FIRST (`sieve_script spamfilter` is type
                  `after`), so anything rspamd flagged is already filed.
                - Aliases are expanded by Postfix before delivery, so `to` still
                  holds the alias but the envelope no longer does. Match on
                  `x-original-to` for alias-routed mail; it survives the
                  rewrite, while `delivered-to` does not.

                Do not use `fileinto :create`: SNM enables only the `fileinto`
                extension, not `mailbox`, so `:create` fails to compile. Folders
                are created automatically by `lda_mailbox_autocreate`.
              '';
            };

            quota = lib.mkOption {
              type = lib.types.nullOr lib.types.str;
              default = null;
              example = "4G";
              description = "Per-account mailbox quota. Null means the default.";
            };
          };
        }
      );
      default = { };
      description = ''
        Login accounts, keyed by the local part (`leon` becomes
        `leon@<domain>`).
      '';
    };

    # Read-only outputs, so the DNS records can reference what the server
    # actually serves instead of a hand-copied value that goes stale.
    mtaStsId = lib.mkOption {
      type = lib.types.str;
      readOnly = true;
      description = ''
        The MTA-STS policy version id, derived from the policy text. The
        `_mta-sts` TXT record must carry exactly this value: senders refuse to
        apply a policy whose id differs from the one DNS advertises, so a
        hand-maintained id silently pins senders to old rules after any edit.
      '';
    };

    mtaStsPolicy = lib.mkOption {
      type = lib.types.str;
      readOnly = true;
      description = "The MTA-STS policy served at https://mta-sts.<domain>/.well-known/mta-sts.txt.";
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.hostname != cfg.webmailHostname;
        message = "modules.mail.hostname and modules.mail.webmailHostname must differ.";
      }
      {
        assertion = cfg.accounts != { };
        message = ''
          modules.mail.accounts is empty: the server would accept mail for
          nobody and Dovecot would have no logins.
        '';
      }
    ];

    # Publish the derived policy values so dns.nix can reference them, keeping
    # the _mta-sts TXT record and the served policy in lockstep by construction.
    modules.mail = { inherit mtaStsId mtaStsPolicy; };

    # ── The mail stack ─────────────────────────────────────────────────────
    mailserver = {
      enable = true;
      fqdn = cfg.hostname;
      domains = [ cfg.domain ];

      # Tracks mailserver *data-layout* migrations, not system.stateVersion.
      # 5 is the current level (required by enableManageSieve). A fresh install
      # starts here; an existing server would have to migrate up instead.
      stateVersion = 5;

      # 50 MiB, also used for Roundcube's upload ceiling.
      messageSizeLimit = 52428800;

      accounts = lib.mapAttrs' (
        name: account:
        lib.nameValuePair "${name}@${cfg.domain}" (
          {
            inherit (account) aliases;
          }
          // lib.optionalAttrs (account.quota != null) { inherit (account) quota; }
          // lib.optionalAttrs (account.hashedPasswordFile != null) {
            inherit (account) hashedPasswordFile;
          }
          // lib.optionalAttrs (account.passwordFile != null) {
            inherit (account) passwordFile;
          }
          // lib.optionalAttrs (account.sieveScript != null) {
            inherit (account) sieveScript;
          }
        )
      ) cfg.accounts;

      # RFC 2142 requires both to resolve; remote MTAs and DNSBLs check.
      aliases = {
        "postmaster@${cfg.domain}" = firstAccount;
        "abuse@${cfg.domain}" = firstAccount;
      };

      # ── Protocols ────────────────────────────────────────────────────────
      enableImapSsl = true; # 993, implicit TLS — what clients actually use
      enableImap = false; # 143/STARTTLS is deprecated (RFC 8314 §4.1)
      enableSubmissionSsl = true; # 465, implicit TLS submission
      enableManageSieve = true; # 4190, server-side filters from the webmail

      # ── TLS ──────────────────────────────────────────────────────────────
      # The cert is defined once below by nginx (`enableACME`); Postfix and
      # Dovecot read the same files out of /var/lib/acme.
      x509.useACMEHost = cfg.hostname;

      # ── Filtering ────────────────────────────────────────────────────────
      # Off on a 1 GB box: ClamAV's signature DB alone wants ~1 GB of RSS.
      # rspamd, included above, does the spam scoring.
      virusScanning = false;

      # rspamd queries DNSBLs constantly; a local resolver keeps the journal
      # readable instead of filling it with timeouts.
      localDnsResolver = true;

      dkim = {
        enable = true;
        keyDirectory = dkimDir;

        # The keypair is generated once, outside the repo, and the private half
        # lives in sops: its public half is a DNS record the zone declares, so
        # generating it on the host would leave the record unsettable until
        # after first boot. keyFile excludes keyType/keyLength by assertion.
        domains.${cfg.domain}.selectors.mail.keyFile = config.sops.secrets.dkim_mail_private_key.path;
      };

      # Dovecot's full-text index is the other RAM hog on this box.
      fullTextSearch.enable = false;
    };

    # ── TLS: one cert for mail.<domain>, shared ────────────────────────────
    security.acme = {
      acceptTerms = true;
      defaults.email = cfg.acmeEmail;
    };

    # No explicit `security.acme.certs."${cfg.hostname}"` here: the nginx vhost
    # below with `enableACME` creates it with the right group and webroot, and
    # nixos-mailserver appends its own reloadServices (postfix, dovecot) to the
    # same cert. A hand-written cert block would only duplicate both — and a
    # reloadServices entry naming a unit that does not exist (`dovecot2.service`;
    # the unit is `dovecot.service`) would warn on every renewal.

    # ── nginx: ACME webroot + Roundcube ────────────────────────────────────
    services.nginx = {
      enable = true;
      recommendedOptimisation = true;
      recommendedTlsSettings = true;
      serverTokens = false;
      # Uploads are bounded by Postfix's message_size_limit instead.
      clientMaxBodySize = "0";

      virtualHosts = {
        # :80 for the mail name — exists only to answer HTTP-01. Everything
        # else is redirected, so the vhost is a challenge endpoint, not a site.
        "${cfg.hostname}" = {
          enableACME = true;
          forceSSL = true;
          locations."/".return = "301 https://${cfg.webmailHostname}$request_uri";
        };

        # The webmail UI itself, on its own name and its own cert.
        "${cfg.webmailHostname}" = {
          enableACME = true;
          forceSSL = true;
          # Roundcube's module owns the php-fpm pool and the webroot; the vhost
          # is left to it (see services.roundcube below), including its
          # `location /`, which sets Cache-Control and therefore drops every
          # inherited add_header. Headers are added per location below instead
          # — putting them at server level is rejected by nginx's config
          # validator (gixy: `add_header_redefinition`).
          locations."/".extraConfig = lib.mkAfter secHeaders;
          locations."~* \\.php(/|$)".extraConfig = lib.mkAfter secHeaders;
        };
      }
      # Each autoconfig name gets its own vhost and certificate, served from one
      # store path (see autoconfigVhosts above). The `mail` vhost redirects to
      # webmail on every path, so these records 404'd when they pointed here.
      // autoconfigVhosts;
    };

    # Port 465 (enableSubmissionSsl) is the only submission service enabled here,
    # and nixos-mailserver gives it a recipient restriction list that resolves the
    # recipient domain BEFORE `permit_sasl_authenticated`:
    #   reject_non_fqdn_recipient,reject_unknown_recipient_domain,permit_sasl_authenticated,reject
    # (`mail-server/postfix.nix:192`, assigned at `:489-490`). Any DNSSEC-bogus
    # recipient domain then SERVFAILs into `450 ... Domain not found` — even for an
    # authenticated user, who cannot be unauthenticated by that point anyway
    # (`smtpd_client_restrictions` already rejects those). Worse, RFC 7672 §2.2
    # requires a bogus MX/address lookup to DEFER the message, not reject it at
    # RCPT; deferring is also what makes `smtp_tls_security_level = dane`
    # meaningful, since the smtp client retries once the domain resolves.
    services.postfix.submissionsOptions.smtpd_recipient_restrictions = lib.mkForce "permit_sasl_authenticated,reject";

    # DANE needs the resolver to validate, not just resolve: Postfix's
    # `smtp_dns_support_level = dnssec` trusts only the AD bit. See the
    # dnssecValidation option.
    #
    # DNS is set explicitly, which is the load-bearing part. Left unset,
    # resolved falls back to whatever the link advertises and then fails every
    # unsigned zone with "no-signature" — which broke
    # `nixos-rebuild --flake github:…` and system.autoUpgrade outright.
    #
    # The upstream is kresd (SNM's `localDnsResolver`, 127.0.0.1:53): a full
    # recursor that walks the tree from the root itself, so no third party sees
    # this host's query stream and DNSBL lookups arrive from our own address
    # instead of a public resolver's (Spamhaus refuses those). Falling back to
    # public resolvers keeps lookups — and autoUpgrade — working if kresd dies;
    # resolved fails over on its own.
    services.resolved.settings.Resolve.DNS = lib.mkIf cfg.dnssecValidation [ "127.0.0.1" ];
    services.resolved.settings.Resolve.FallbackDNS = lib.mkIf cfg.dnssecValidation [
      "1.1.1.1"
      "9.9.9.9"
    ];
    services.resolved.settings.Resolve.DNSSEC = if cfg.dnssecValidation then "true" else "false";

    # ── Roundcube ──────────────────────────────────────────────────────────
    services.roundcube = {
      enable = true;
      hostName = cfg.webmailHostname;
      # The module then writes the vhost itself, with enableACME + forceSSL.
      configureNginx = true;
      maxAttachmentSize = config.mailserver.messageSizeLimit / 1024 / 1024;
      dicts = with pkgs.aspellDicts; [
        en
        de
      ];
      extraConfig = ''
        $config['imap_host'] = 'ssl://${cfg.hostname}:993';
        $config['smtp_host'] = 'ssl://${cfg.hostname}:465';
        $config['smtp_user'] = '%u';
        $config['smtp_pass'] = '%p';
        // The UI is served from webmail.<domain> but logs in against mail.<domain>.
        $config['username_domain'] = '${cfg.domain}';
        $config['mail_domain'] = '${cfg.domain}';
        // ManageSieve: lets the webmail edit server-side filters.
        $config['managesieve_host'] = 'tls://${cfg.hostname}:4190';
        $config['managesieve_usetls'] = true;
      '';
    };

    # ── Firewall ───────────────────────────────────────────────────────────
    # mailserver.openFirewall (default true) opens 25/465/993/4190. No 143 or
    # 587: those are the STARTTLS variants of protocols enabled below in their
    # implicit-TLS form, so they are never opened.
    networking.firewall.allowedTCPPorts = [
      80
      443
    ];

    # ── Intrusion handling for the mail protocols ──────────────────────────
    # The sshd jail is on for every server host, which leaves the three ports
    # exposed to the whole internet unjailed. dovecot covers 993 and 4190
    # (imap-login/managesieve-login lines); postfix covers 25 and 465.
    #
    # Both stock filters carry their own `journalmatch`, so the systemd backend
    # picks up the right unit without per-jail wiring. Verified against this
    # box's own logs before enabling: 4/880 dovecot lines and 24/3682 postfix
    # lines matched, i.e. the auth-failure lines and not the delivery chatter.
    services.fail2ban.jails = {
      dovecot.settings = {
        enabled = true;
        backend = "systemd";
        # Brute force is slow per-connection (TLS handshake each time), so a
        # wider window than sshd's catches the ones that stay under 5 tries.
        findtime = "30m";
        maxretry = 5;
        bantime = "1h";
      };
      postfix.settings = {
        enabled = true;
        backend = "systemd";
        findtime = "30m";
        maxretry = 5;
        bantime = "1h";
        # Stock `mode=more` only matches the RCPT rejections. `extra` adds the
        # SASL failure rule, which is what catches password guessing on 465
        # where no RCPT ever arrives. Verified against 3682 real log lines:
        # 24 matched, and the offenders were relay abuse (103.47.145.x) plus
        # protocol probes — diagnostic scanners hit 1-3 times, so maxretry=5
        # leaves mxtoolbox/censys/shadowserver unbanned.
        mode = "extra";
      };
      # Webmail is the one auth path fail2ban would otherwise miss entirely:
      # PHP opens the IMAP connection from 127.0.0.1, so dovecot's jail sees the
      # loopback address and ignoreIP discards it. Roundcube logs the real client
      # ip itself, so this jail bans the actual attacker.
      roundcube.settings = {
        enabled = true;
        backend = "systemd";
        filter = "roundcube-auth";
        findtime = "30m";
        maxretry = 5;
        bantime = "1h";
      };
    };

    # ── PHP hardening (the only pool on this host is roundcube's) ──────────
    # PHP advertises its exact build in `X-Powered-By`, which is free
    # reconnaissance for a version-specific exploit; nothing consumes it.
    #
    # The session knobs cover anything PHP starts itself — Roundcube already
    # sets HttpOnly+Secure on its own cookie. `use_strict_mode` rejects a
    # session id the server never issued, which closes session fixation.
    services.phpfpm.pools.roundcube.phpOptions = {
      expose_php = "Off";
      "session.cookie_httponly" = "1";
      "session.cookie_secure" = "1";
      "session.use_strict_mode" = "1";
    };

    # ── DKIM key ───────────────────────────────────────────────────────────
    # rspamd reads this directly (the path is what mailserver.dkim...keyFile
    # above points at), so the file must belong to rspamd, not root: sops-nix
    # defaults to 0400 root:root and the signer would get EACCES on every send.
    sops.secrets.dkim_mail_private_key = {
      owner = config.services.rspamd.user;
      group = config.services.rspamd.group;
      mode = "0400";
    };

    # Dovecot's userdb is generated by its preStart, which runs as root and is
    # what reads this file, so default root ownership is correct here.
    #
    # restartUnits is what makes a password *change* take effect. Dovecot's unit
    # only depends on the secret's path, so its definition is byte-identical when
    # the hash changes and systemd sees nothing to restart — the preStart that
    # regenerates /run/dovecot2/passwd never runs, and the old hash keeps
    # authenticating while the new one is silently ignored.
    sops.secrets.leon_password_hash.restartUnits = [ "dovecot.service" ];

    # ── Disk ───────────────────────────────────────────────────────────────
    # Nothing to declare: nixos-mailserver creates dkim.keyDirectory (as a
    # tmpfiles rule owned by the rspamd user, which is what actually signs) and
    # StorageDirectory for /var/vmail. An extra rule naming an `opendkim` user
    # would fail at boot — there is no such user, DKIM here is rspamd's.
  };
}
