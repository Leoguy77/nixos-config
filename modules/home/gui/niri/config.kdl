// Niri compositor config — edit this file directly, then `niri msg action
// reload-config`. Home Manager symlinks it out of the store
// (mkOutOfStoreSymlink in niri.nix), so changes take effect without a rebuild.
//
// This file does NOT restate niri's defaults. It `include`s the default config
// niri ships (632 lines: every standard bind, input default, window rule, and a
// `spawn-at-startup "waybar"` that is now a no-op -- waybar is not installed,
// noctalia draws the bar, and a missing binary in spawn-at-startup only logs an
// error, it cannot break the session) and only overrides what is actually
// different. That works because the parser merges each node into
// `Config::default()`, and for the one section where merging would be wrong --
// `binds {}` -- conflicting keys are REPLACED rather than rejected
// (niri-config/src/lib.rs:219-231: "We replace conflicting binds, rather than
// error, to support the use-case where you import some preconfigured-dots.kdl,
// then override some binds with your own").
//
// Consequence when editing: a bind written here silently wins over the included
// one. Keep this file to deliberate differences only.
//
// `default-config.kdl` next to this file is a separate symlink into the niri
// build we actually run, so the include cannot drift from the compositor
// version. Relative includes resolve against the directory of the config as
// opened, i.e. ~/.config/niri/ (verified against niri-config/src/lib.rs:345-380).
include "default-config.kdl"

input {
  // The power key goes to logind (HandlePowerKey = "hibernate"), not to niri.
  // niri maps it to Action::Suspend (src/input/mod.rs:4414) and holds a block
  // inhibitor on handle-power-key, so logind never applies policy -- the very
  // press that powers the machine back on after a hibernate suspends it again.
  disable-power-key-handling

  // xkb is deliberately NOT set. With an empty `xkb {}` block (as in the
  // included default) niri takes the layout from org.freedesktop.locale1, which
  // NixOS drives from services.xserver.xkb.layout (modules/nixos/locale.nix).
  // Writing a layout here would silently ignore modules.nixos.locale.

  // `touchpad` REPLACES the included one wholesale rather than merging
  // field-by-field -- merge_clone! in niri-config/src/macros.rs:11-19 does
  // `clone_from`, and the shipped default-config.kdl says as much: "Omitting
  // settings disables them". So tap + natural-scroll must be restated here or
  // they are silently switched off. (Verified: dropping them left only `dwt`
  // in effect.)
  touchpad {
    tap
    natural-scroll
    dwt // ignore the touchpad while typing
  }
}

// The focus ring. niri's default is a 4px #7fc8ff ring -- a light blue that is
// not in this desktop's palette, and the only element that still looked like
// stock niri once everything else was Catppuccin.
//
// `BorderRule::merge_with` (niri-config/src/appearance.rs:686-698) merges field
// by field -- merge_on_off, then merge_clone_opt on width, then
// merge_color_gradient_opt on the colours -- so a partial block only overrides
// what it names and keeps the rest of the included default. This is the
// opposite of `touchpad`, which replaces wholesale (merge_clone!); see the note
// at the top of this file.
//
// 2px rather than the default 4: at this display's 1.25 scale a 4px ring draws
// 5 physical pixels of solid colour on every edge of the focused tile, which
// reads as a frame bolted around the window rather than a focus cue. 2px draws
// 2-3 and still stands out against #1e1e2e.
//
// Blue rather than the more obvious mauve/peach accent: the ring sits directly
// against the bar (also Catppuccin) and against app content, and blue #89b4fa
// is the palette's own selection/focus colour (it is what fuzzel uses for its
// border and prompt above).
//
// `layout {}` also silently forces `border` on when the section is written with
// no explicit on/off (lib.rs:267-277), so `border` is left out of this block
// entirely -- it stays off as the included default.
layout {
  focus-ring {
    width 2
    active-color "#89b4fa"
    inactive-color "#45475a"
  }
}

// The audio mixer is a dialog, not a document: it floats at a readable size
// instead of swallowing a whole tile. niri tiles everything by default.
// `window-rule` is append-only (`m_push!`, lib.rs:214), so this does not disturb
// the rules in default-config.kdl -- notably the Firefox PiP float.
//
// `open-floating` is the part that matters. Two size mechanisms were tried and
// only one survives: `default-window-height { fixed N }` is merely a hint in the
// initial xdg configure, and pavucontrol ignores it because it restores
// width/height from ~/.config/pavucontrol.ini on every start. `max-height` is a
// runtime clamp (apply_min_max_size, workspace.rs:830-841) and does hold.
// Verified: 744x796 tiled -> floating at 744x640; niri remembers the floating
// geometry afterwards.
//
// No width clamp: pavucontrol's three-tab layout is already narrow, and a cap
// would clip the per-application stream list, which is the reason to open it.
window-rule {
  match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
  open-floating true
  max-height 640
}

// niri has no idle daemon of its own; swayidle does the lock-then-blank ladder.
//
// ONE swayidle process, and not a single `-w` in it.
// `-w` makes swayidle waitpid() the command it ran (main.c:173), which blocks
// its whole event loop -- so a later timeout cannot fire until the earlier
// command exits. With one `-w` ladder that produced two real bugs:
//
//   - the 600s blank was queued behind hyprlock and fired the instant the
//     machine was unlocked, so the screen went black right after typing the
//     password and needed input to come back;
//   - and it never blanked at all during a long lock, because it could not fire
//     while hyprlock was still up.
//
// Measured, not inferred: with -w, a 3s blank timeout sitting behind a 6s
// command ran at t=7s -- the same second the 6s command exited -- instead of at
// t=3s.
//
// `before-sleep` gets no `-w` either. That is where the flag is most tempting --
// logind suspends as soon as swayidle drops its delay inhibitor, so in theory
// hyprlock should be up first -- but -w blocks on a process that never exits, so
// the inhibitor is never dropped and logind waits out its full
// InhibitDelayMaxSec (5s, logind-core.c:44) before suspending anyway. Measured
// on 2026-11-20: lid closed 08:40:51, reopened 08:40:54, and suspend still
// executed at 08:40:57 with the lid already open -- the display came back and
// then went black under the user, who reported the machine powering off.
// Without -w swayidle forks hyprlock and releases the inhibitor at once, so a
// lid close takes effect immediately and reopening it is an ordinary wake
// instead of one swallowed by a pending suspend. hyprlock asks for the lock
// while starting up, before it paints, so only a few milliseconds of exec can
// be lost -- never the lock.
//
// One KDL string = one argv entry: spawn-at-startup execs directly, with no
// shell. swayidle matches argv[i] against the literal words `timeout` and
// `before-sleep` (swayidle main.c:864-892) and exits with "Unsupported command"
// on anything else, so the keywords must be their own arguments. The command
// *it* runs goes through `sh -c` (main.c:156), so quoting inside that one
// argument is fine.
//
// Bare command names are used throughout this file: everything spawned here is
// in home.packages, which puts it on the session PATH.
// hyprlock, not swaylock: swaylock has no password field at all -- the ring is
// its entire UI. hyprlock renders a real input field with a blurred screenshot
// of the desktop behind it. Both speak ext-session-lock-v1, which niri serves
// (niri src/handlers/mod.rs:70), and hyprlock's `path=screenshot` needs
// wlr-screencopy, which niri also serves (src/handlers/mod.rs:22,86,95,637).
// Unlock was proven in a nested niri session before this line was changed --
// a locker that cannot be unlocked strands the machine with no way back in.
//
// One process, not two: a second swayidle for `before-sleep` shared nothing with
// the first and only existed to carry `-w`, which is now gone. swayidle takes all
// its commands in one argv (main.c:864-892 reads them left to right).
spawn-at-startup "swayidle" \
  "timeout" "300" "hyprlock" \
  "timeout" "600" "niri msg action power-off-monitors" \
  "before-sleep" "hyprlock"

// Noctalia, for the top bar. It REPLACES waybar, which is no longer installed.
// The roles it does not take -- notifications, OSD, clipboard, wallpaper,
// lockscreen -- stay with swaync, swayosd, cliphist, swaybg and hyprlock, all
// switched off in noctalia.toml. See that file for the reasoning.
//
// `-d` backgrounds it. `spawn-at-startup` execs directly and does not wait, so
// a foreground noctalia would work too, but it would then be a child process
// whose death niri never notices or restarts. The daemon flag leaves it in
// charge of its own lifetime and gives the same single instance the IPC socket
// is per.
spawn-at-startup "noctalia" "-d"

// The widget set in noctalia.toml leaves out `wallpaper` and `clipboard`, so
// those two keep their own clients below. The launcher widget on the left is
// noctalia's own; Mod+D still opens fuzzel, which is a separate choice (fuzzel
// is themed to the same palette and already muscle-memory on this box).

// Notifications are not spawned here: swaync is a systemd user service
// (modules/home/gui/niri.nix, services.swaync). Both it and mako claim the
// org.freedesktop.Notifications D-Bus name, so running both would just race.

// niri draws no background of its own -- it has `background-color` per output
// and nothing else (niri-config/src/lib.rs:748), so an image needs a separate
// layer-shell client. swaybg is that client and does exactly one thing.
//
// `spawn-sh-at-startup` rather than `spawn-at-startup` for this one, because
// the path goes through `~`: `spawn-at-startup` execs directly with no shell
// (niri/src/utils/spawning.rs:66-84) and would hand swaybg a literal `~`. The
// `-sh-` variant (niri-config/src/lib.rs:213) wraps it in `sh -c`, which is
// what expands it. Everything else here is a bare command name and does not
// need the shell.
spawn-sh-at-startup "swaybg -i ~/.config/niri/wallpaper.png -m fill"

// -- Overrides -------------------------------------------------------------
// The defaults bind Mod+T to alacritty and Mod+D to fuzzel already; only the
// terminal differs (alacritty is not installed here).
binds {
  Mod+T hotkey-overlay-title="Terminal: kitty" { spawn "kitty"; }
  Mod+D hotkey-overlay-title="Launcher: fuzzel" { spawn "fuzzel"; }

  // Win+L, like Windows. `Mod` is the compositor modifier (Mod4/Logo by
  // default), so this is Meta+L. The default config binds Mod+L to
  // focus-column-right, but Mod+Right is the same action (default-config.kdl
  // :406,:410), so nothing is lost. A `binds {}` entry replaces the bind for
  // that key rather than erroring (niri-config/src/lib.rs:219-231).
  Mod+L hotkey-overlay-title="Lock" { spawn "hyprlock"; }
  Super+Alt+L hotkey-overlay-title="Lock" { spawn "hyprlock"; }

  // Notification control centre. Mod+N is free in the default config (it binds
  // Mod+M, Mod+V, Mod+Shift+V, but never Mod+N), so nothing is overridden.
  Mod+N hotkey-overlay-title="Notifications" { spawn "swaync-client" "-t"; }
  Mod+Shift+N hotkey-overlay-title="Do Not Disturb" { spawn "swaync-client" "-d"; }
  Mod+Shift+C hotkey-overlay-title="Clear Notifications" { spawn "swaync-client" "-C"; }

  // Power menu. The default config binds Mod+Shift+E to a bare `quit` with a
  // confirmation dialog; wlogout's logout button runs the same action, so quit
  // stays reachable and lock/suspend/reboot/shutdown gain a binding.
  Mod+Shift+E hotkey-overlay-title="Power Menu" { spawn "wlogout"; }

  // Clipboard history. Mod+Shift+V would be the natural choice but the default
  // config already binds it to switch-focus-between-floating-and-tiling, and
  // Mod+V toggles floating. Mod+X is free.
  //
  // The pipeline is the standard cliphist one: list the history, pipe it into
  // fuzzel in dmenu mode, then hand the chosen line back to `cliphist decode`
  // and into wl-copy. `cliphist list` prefixes each line with an ID, which is
  // why the decode step takes the whole line rather than the text.
  Mod+X hotkey-overlay-title="Clipboard History" {
    spawn-sh "cliphist list | fuzzel --dmenu --prompt='Clipboard: ' --width=60 | cliphist decode | wl-copy";
  }

  // ── Media keys ───────────────────────────────────────────────────────────
  // The default config binds 12 XF86 keys straight to wpctl/brightnessctl/
  // playerctl. Those do the action but draw NOTHING: press volume-up and the
  // only feedback is that the audio is louder. This restates those keys to go
  // through swayosd-client instead, which performs the same action and shows a
  // bar while doing it.
  //
  // swayosd-client is a full replacement, not an add-on: `--output-volume
  // raise` calls wpctl itself. Pairing it WITH wpctl would move the volume
  // twice per press. Hence every key below is restated, not supplemented.
  //
  // allow-when-locked=true is carried over deliberately - volume and brightness
  // are the two things that should still work on a locked screen.
  //
  // The media keys (play/stop/prev/next) are left alone: playerctl has no OSD
  // to draw and swayosd's player bar needs `--player all|auto`, which is a
  // behaviour change nobody asked for.
  //
  // Caps Lock gets an OSD too, on its own LED. `--caps-lock-led` reads
  // /sys/class/leds/<name>, and this keyboard exposes input0::capslock.
  XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
  XF86AudioMute allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
  XF86AudioMicMute allow-when-locked=true { spawn "swayosd-client" "--input-volume" "mute-toggle"; }
  XF86MonBrightnessUp allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
  XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }

  // Region screenshot you can mark up before sending.
  //
  // niri's own screenshot UI (Print, in default-config.kdl:611) saves to a file
  // or the clipboard but cannot annotate - there is no arrow, text, blur or
  // brush code in src/ui/screenshot_ui.rs. So Print stays for "grab the whole
  // screen, done", and this is for "grab a region, circle the thing, paste it
  // into a chat".
  //
  // slurp picks the region, grim captures it (niri serves wlr-screencopy), and
  // satty annotates. satty's default copy command is xclip, which does not
  // exist on Wayland, so `--copy-command wl-copy` is load-bearing: without it
  // the copy button silently does nothing.
  //
  // `--actions-on-enter save-to-clipboard,exit` makes Return copy AND close;
  // the `exit` half is required - actions-on-enter defaults to an empty list
  // (configuration.rs:760), so the flag alone replaces the default and leaves
  // the window open after copying. Escape already defaults to exit
  // (configuration.rs:761), so it needs no flag. No -o, so no directory fills
  // up with screenshots nobody asked to keep.
  Mod+Shift+S hotkey-overlay-title="Screenshot region" {
    spawn-sh "grim -g \"$(slurp)\" - | satty --filename - --copy-command wl-copy --actions-on-enter save-to-clipboard,exit";
  }
}
