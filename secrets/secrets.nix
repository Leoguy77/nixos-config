# Agenix secrets configuration
# Define which secrets exist and who can decrypt them
#
# Recipients can be:
# - SSH public keys (e.g., "ssh-rsa AAAA...")
# - SSH key files (e.g., "/home/user/.ssh/id_ed25519.pub")
# - Age public keys (e.g., "age1...")
#
# This file is NOT encrypted - it's safe to commit to git

let
  # Your SSH public key for decrypting secrets
  leon = "ssh-rsa ";
  
  # Surface host SSH key (auto-generated by NixOS)
  surface = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...";  # Replace with actual host key
  
in
{
  # Example secrets (uncomment and customize as needed):
  
  # "ssh-key.age".publicKeys = [ leon surface ];
  # "api-token.age".publicKeys = [ leon ];
  # "database-password.age".publicKeys = [ leon surface ];
  
  # Add your secrets here following the pattern:
  # "<filename>.age".publicKeys = [ <list of recipients> ];

  # Restic backup repository password (recommended for backups):
  #   1. Uncomment the line below.
  #   2. Run: agenix -e restic-password.age
  #   3. In security.nix age.secrets, add:
  #        "restic-password".file = ../../secrets/restic-password.age;
  #   4. In the host, set:
  #        modules.backup.passwordFile = config.age.secrets."restic-password".path;
  # "restic-password.age".publicKeys = [ leon surface ];
}
