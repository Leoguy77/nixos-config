# Surface-specific configuration
# This is the main entry point for the surface host (desktop/laptop)
{
  config,
  pkgs,
  lib,
  inputs,
  mylib,
  myvars,
  pkgs-stable,
  ...
}:

{
  imports = mylib.scanPaths ../../modules/nixos ++ [
    # Hardware configuration (generated by nixos-generate-config)
    ./hardware-configuration.nix
  ];

  # Enable all NixOS modules
  modules.boot.enable = true;
  modules.boot.systemdBoot = true;
  modules.boot.efi = true;

  modules.system.enable = true;
  modules.services.enable = true;
  modules.services.x11 = true; # Enable X11
  modules.services.plasma = true; # Enable KDE Plasma desktop
  modules.services.pipewire = true; # Enable audio
  modules.services.printing = true; # Enable printing
  modules.services.ssh = true; # Enable SSH server
  modules.services.rdp = true; # Enable RDP server
  modules.services.autoCpufreq = true; # Enable power management

  # Disable power-profiles-daemon (conflicts with auto-cpufreq)
  services.power-profiles-daemon.enable = false;

  modules.packages.enable = true;
  modules.users.enable = true;
  modules.security.enable = true;
  modules.security.enableSecrets = true; # Enable agenix secrets

  # ponytail: daily rebuild from GitHub — flake.lock updated by GitHub Action
  system.autoUpgrade = {
    enable = true;
    flake = "github:Leoguy77/nixos-config#surface";
    dates = "daily";
    persistent = true;
    allowReboot = false;
  };

  # Surface firmware updates via fwupd (LVFS)
  services.fwupd.enable = true;

  # 1Password system integration (required for `op` CLI / browser unlock)
  modules.onepassword.enable = true;

  # Automated encrypted backups (restic)
  modules.backup.enable = true;
  modules.backup.paths = [
    "/home/${myvars.username}"
  ];
  # Local repository by default; change to a remote target (sftp/s3/b2)
  # for off-machine backups. Optionally set modules.backup.passwordFile
  # to an agenix secret path for a managed repository password.
  # modules.backup.repository = "sftp:user@host:/srv/restic";
  # modules.backup.passwordFile = config.age.secrets."restic-password".path;

  # Host-specific settings from vars
  networking.hostName = "surface";

  # Use static IP if configured (optional)
  # networking.interfaces.${myvars.networking.hostsAddr.surface.iface}.ipv4.addresses = [
  #   {
  #     address = myvars.networking.hostsAddr.surface.ipv4;
  #     prefixLength = 24;
  #   }
  # ];

  # Overlays: must be at NixOS config level when useGlobalPkgs = true
  # Affects both NixOS system packages and Home Manager packages.
  nixpkgs.overlays = import ../../overlays;

  # Home Manager integration
  home-manager = {
    useGlobalPkgs = true;
    useUserPackages = true;
    extraSpecialArgs = {
      inherit
        mylib
        myvars
        pkgs-stable
        inputs
        pkgs
        ;
    };
    users.leoguy77 = { config, ... }: {
      imports = [
        ../../modules/home
        ./home.nix # Surface-specific home overrides
      ];

      # Set stateVersion explicitly
      home.stateVersion = myvars.system.stateVersion;
    };
  };
}
