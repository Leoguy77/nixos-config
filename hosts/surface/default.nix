{
  mylib,
  ...
}:

{
  imports = mylib.scanPaths ../../modules/nixos ++ [
    # Hardware configuration (generated by nixos-generate-config)
    ./hardware-configuration.nix
    # Laptop role: the shared desktop stack + battery-aware power management.
    ../../profiles/laptop.nix
  ];

  # Point the desktop profile at this host's home-manager overrides.
  modules.desktop.homeModule = ./home.nix;

  # Optional services this host historically ran (surfaces the per-host lever —
  # e.g. not every desktop opens RDP). Opt in to preserve prior behaviour.
  modules.rdp.enable = true;
  modules.printing.enable = true;
  modules.ssh.enable = true;
  modules.tailscale.enable = true;
  modules.tailscale.openFirewall = true; # direct WireGuard (41641) instead of DERP relay

  # Host-specific settings from vars
  networking.hostName = "surface";

  # Overlays: must be at NixOS config level when useGlobalPkgs = true
  # Affects both NixOS system packages and Home Manager packages.
  nixpkgs.overlays = import ../../overlays;

  # Daily rebuild from GitHub — flake.lock updated by GitHub Action.
  system.autoUpgrade = {
    enable = true;
    flake = "github:Leoguy77/nixos-config#surface";
    dates = "daily";
    persistent = true;
    allowReboot = false;
  };
}
