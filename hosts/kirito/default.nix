{
  mylib,
  ...
}:

{
  imports = mylib.scanPaths ../../modules/nixos ++ [
    # Hardware configuration (generated by nixos-generate-config)
    ./hardware-configuration.nix
    # Laptop role: the shared desktop stack + battery-aware power management.
    ../../profiles/laptop.nix
  ];

  # Point the desktop profile at this host's home-manager overrides.
  modules.desktop.homeModule = ./home.nix;

  # Preserve dotfile conflict handling: pre-existing files are moved to
  # <name>.hm-backup rather than failing activation.
  modules.desktop.backupFileExt = "hm-backup";

  # Optional services this host historically ran (surfaces the per-host lever —
  # e.g. not every desktop opens RDP). Opt in to preserve prior behaviour.
  modules.rdp.enable = true;
  modules.printing.enable = true;
  modules.ssh.enable = true;
  modules.tailscale.enable = true;
  modules.tailscale.openFirewall = true; # direct WireGuard (41641) instead of DERP relay

  # flipdot Hackspace WireGuard VPN (wg0) — NetworkManager connection, now set up
  # as a SAFE systemd one-shot service (flipdot-wg0) that runs in the real root
  # AFTER boot, instead of a system.activationScript. The old activationScript
  # ran nmcli inside the initrd (NixOS stage-1), where NetworkManager isn't up,
  # which broke switch-root ("Switch root target contains no usable init") on
  # all generations with wireguard enabled (11+). The service form boots fine.
  modules.wireguard.enable = true;
  modules.wireguard.address = "192.168.6.109/32"; # flipdot-assigned IP

  # AusweisApp: the smartphone announces itself as a card reader by
  # broadcasting a REMOTE_IFD discovery datagram to UDP 24727 (TR-03124-1).
  # Without this rule the phone never appears in the app — verified by
  # removing the rule and watching the phone stop showing up.
  # ponytail: open on all interfaces; narrow to the LAN subnet if the
  # exposure ever matters.
  networking.firewall.allowedUDPPorts = [ 24727 ];

  # pi's Home Assistant MCP config — system-level sops secret decrypted with
  # kirito's age host key (headless, no card). The plaintext lands in the
  # user's home anyway, so card-protection bought nothing here; the old
  # home-manager sops route failed headless (no TTY for the card PIN).
  sops.secrets.pi_mcp_json = {
    path = "/home/leoguy77/.pi/agent/mcp.json";
    owner = "leoguy77";
  };

  # Host-specific settings
  networking.hostName = "kirito";

  # Overlays: must be at NixOS config level when useGlobalPkgs = true
  # Affects both NixOS system packages and Home Manager packages.
  nixpkgs.overlays = import ../../overlays;

  # Daily rebuild from GitHub — flake.lock updated by GitHub Action.
  # Root cause of the past boot failures (generations 11+) was the WireGuard
  # activationScript running nmcli in the initrd — fixed by moving it to a safe
  # systemd service (flipdot-wg0) that runs after boot. autoUpgrade is re-enabled.
  system.autoUpgrade = {
    enable = true;
    flake = "github:Leoguy77/nixos-config#kirito";
    dates = "daily";
    persistent = true;
    allowReboot = false;
  };
}
